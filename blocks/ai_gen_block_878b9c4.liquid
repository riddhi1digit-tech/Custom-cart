{% doc %}
  @prompt
    create features collection section morden slider it sholud minimal slider it sholud attrective slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-featured-collections-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; padding:36px 0; color:#121212; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__inner { width:100%; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__heading-row { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:22px; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__heading { margin:0; color:#121212; font-size:clamp(24px,3vw,38px); line-height:1.12; letter-spacing:-.035em; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__description { margin:8px 0 0; color:#444; font-size:15px; line-height:1.5; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__controls { display:flex; gap:8px; flex:0 0 auto; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__arrow { display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; padding:0; border:1px solid #c8c8c8; border-radius:50%; background:#fff; color:#121212; cursor:pointer; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__arrow:hover:not(:disabled) { border-color:#121212; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__arrow:disabled { opacity:.45; cursor:not-allowed; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__arrow:focus-visible, .ai-featured-collections-{{ ai_gen_id }} a:focus-visible { outline:2px solid #121212; outline-offset:3px; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__arrow svg { width:18px; height:18px; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__track { display:flex; gap:18px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; padding:2px 1px 8px; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__track::-webkit-scrollbar { display:none; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__card { flex:0 0 calc((100% - 54px)/4); min-width:0; scroll-snap-align:start; color:inherit; text-decoration:none; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__media { position:relative; overflow:hidden; aspect-ratio:4/5; background:#f3f3f3; border-radius:4px; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__media img, .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__media svg { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__media img { transition:transform .35s ease; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__card:hover .ai-featured-collections__media img { transform:scale(1.035); }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__details { display:flex; align-items:baseline; justify-content:space-between; gap:10px; padding-top:12px; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__title { margin:0; font-size:16px; line-height:1.35; font-weight:600; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__count { flex:0 0 auto; color:#555; font-size:13px; }
  .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__empty { width:100%; padding:32px 20px; background:#f3f3f3; color:#444; text-align:center; }
  @media screen and (max-width:749px) {
    .ai-featured-collections-{{ ai_gen_id }} { padding:26px 0; }
    .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__heading-row { align-items:center; margin-bottom:16px; }
    .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__card { flex-basis:72%; }
    .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__track { gap:12px; }
    .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__controls { gap:6px; }
    .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__arrow { width:36px; height:36px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__track { scroll-behavior:auto; }
    .ai-featured-collections-{{ ai_gen_id }} .ai-featured-collections__media img { transition:none; }
  }
{% endstyle %}
<featured-collections-{{ ai_gen_id }} class="ai-featured-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collections__inner">
    <div class="ai-featured-collections__heading-row">
      <div>
        {% if block.settings.heading != blank %}<h2 class="ai-featured-collections__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
        {% if block.settings.description != blank %}<p class="ai-featured-collections__description">{{ block.settings.description | escape }}</p>{% endif %}
      </div>
      <div class="ai-featured-collections__controls" aria-label="Slider controls">
        <button class="ai-featured-collections__arrow" type="button" data-direction="previous" aria-label="Previous collections"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button class="ai-featured-collections__arrow" type="button" data-direction="next" aria-label="Next collections"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
    {% assign chosen_collections = block.settings.collections %}
    {% if chosen_collections != blank %}
      <div class="ai-featured-collections__track" tabindex="0" aria-label="Featured collections">
        {% for collection in chosen_collections %}
          <a class="ai-featured-collections__card" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
            <div class="ai-featured-collections__media">
              {% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
              {% else %}<div class="ai-featured-collections__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
            </div>
            <div class="ai-featured-collections__details"><h3 class="ai-featured-collections__title">{{ collection.title | escape }}</h3>{% if block.settings.show_product_count %}<span class="ai-featured-collections__count">{{ collection.products_count }} items</span>{% endif %}</div>
          </a>
        {% endfor %}
      </div>
    {% else %}<div class="ai-featured-collections__empty">Choose collections in the block settings to display your slider.</div>{% endif %}
  </div>
</featured-collections-{{ ai_gen_id }}>
<script>
(function(){
  const tagName='featured-collections-{{ ai_gen_id }}';
  if(customElements.get(tagName)) return;
  class FeaturedCollections extends HTMLElement {
    connectedCallback(){
      this.track=this.querySelector('.ai-featured-collections__track');
      this.buttons=this.querySelectorAll('.ai-featured-collections__arrow');
      if(!this.track) return;
      this.buttons.forEach((button)=>button.addEventListener('click',()=>{
        const card=this.track.querySelector('.ai-featured-collections__card');
        if(!card) return;
        const gap=parseFloat(getComputedStyle(this.track).gap)||0;
        this.track.scrollBy({left:button.dataset.direction==='next'?card.getBoundingClientRect().width+gap:-(card.getBoundingClientRect().width+gap),behavior:'smooth'});
      }));
      this.updateButtons=()=>{
        const maxScroll=this.track.scrollWidth-this.track.clientWidth;
        this.buttons.forEach((button)=>{button.disabled=button.dataset.direction==='previous'?this.track.scrollLeft<=2:this.track.scrollLeft>=maxScroll-2;});
      };
      this.track.addEventListener('scroll',this.updateButtons,{passive:true});
      this.resizeHandler=()=>this.updateButtons();
      window.addEventListener('resize',this.resizeHandler);
      this.updateButtons();
    }
    disconnectedCallback(){
      if(this.track&&this.updateButtons)this.track.removeEventListener('scroll',this.updateButtons);
      if(this.resizeHandler)window.removeEventListener('resize',this.resizeHandler);
    }
  }
  customElements.define(tagName,FeaturedCollections);
})();
</script>
{% schema %}
{
  "name": "Collection slider",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"heading","label":"Heading","default":"Featured collections"},
    {"type":"text","id":"description","label":"Description","default":"Explore our curated collections"},
    {"type":"collection_list","id":"collections","label":"Collections","limit":8},
    {"type":"checkbox","id":"show_product_count","label":"Show product count","default":false},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets":[{"name":"Collection slider"}],
  "tag":null,
  "class":"featured-collection-slider"
}
{% endschema %}