{% doc %}
  @prompt
    create testimonial section like magazine style editorial layout morden testimonial section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-quote-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: clamp(28px, 5vw, 72px);
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__inner-{{ ai_gen_id }} {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, .9fr);
    gap: clamp(32px, 7vw, 100px);
    align-items: center;
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__copy-{{ ai_gen_id }} { min-width: 0; }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: .16em;
    line-height: 1.5;
    text-transform: uppercase;
    color: {{ block.settings.accent_color }};
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__heading-{{ ai_gen_id }} {
    margin: 0 0 28px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: clamp(30px, 4vw, 54px);
    line-height: 1.08;
    letter-spacing: -.035em;
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__quote-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: clamp(20px, 2.2vw, 29px);
    line-height: 1.45;
    letter-spacing: -.015em;
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__quote-{{ ai_gen_id }} p { margin: 0; }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__rule-{{ ai_gen_id }} {
    width: 48px;
    height: 1px;
    margin: 30px 0 18px;
    border: 0;
    background: {{ block.settings.accent_color }};
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__byline-{{ ai_gen_id }} {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__name-{{ ai_gen_id }} { font-weight: 600; }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__image-wrap-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e9e5df;
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__image-wrap-{{ ai_gen_id }} img,
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__image-wrap-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__placeholder-{{ ai_gen_id }} { width: 100%; height: 100%; }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__placeholder-{{ ai_gen_id }} svg { color: #625b53; }
  .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__empty-{{ ai_gen_id }} {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 9px 12px;
    background: rgba(255,255,255,.94);
    color: #24211f;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
  }
  @media screen and (max-width: 749px) {
    .ai-editorial-quote-{{ ai_gen_id }} { width: 100%; padding: 32px 22px; }
    .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__inner-{{ ai_gen_id }} { grid-template-columns: 1fr; gap: 28px; }
    .ai-editorial-quote-{{ ai_gen_id }} .ai-editorial-quote__image-wrap-{{ ai_gen_id }} { aspect-ratio: 5 / 4; }
  }
{% endstyle %}

<div class="ai-editorial-quote-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-quote__inner-{{ ai_gen_id }}">
    <div class="ai-editorial-quote__copy-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}<p class="ai-editorial-quote__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-editorial-quote__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.testimonial != blank %}<blockquote class="ai-editorial-quote__quote-{{ ai_gen_id }}">{{ block.settings.testimonial }}</blockquote>{% endif %}
      <hr class="ai-editorial-quote__rule-{{ ai_gen_id }}">
      <p class="ai-editorial-quote__byline-{{ ai_gen_id }}">
        {% if block.settings.customer_name != blank %}<span class="ai-editorial-quote__name-{{ ai_gen_id }}">{{ block.settings.customer_name | escape }}</span>{% endif %}
        {% if block.settings.customer_detail != blank %}{% if block.settings.customer_name != blank %}<span aria-hidden="true"> · </span>{% endif %}{{ block.settings.customer_detail | escape }}{% endif %}
      </p>
    </div>
    <div class="ai-editorial-quote__image-wrap-{{ ai_gen_id }}">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | default: block.settings.customer_name | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-editorial-quote__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}</div>
        <div class="ai-editorial-quote__empty-{{ ai_gen_id }}">Add an editorial or customer image</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial testimonial",
  "settings": [
    { "type": "header", "content": "Story" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A STORY TO TREASURE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the moments that matter." },
    { "type": "richtext", "id": "testimonial", "label": "Testimonial", "default": "<p>Share a genuine customer story here. A personal detail makes this editorial feature feel warm, memorable, and authentic.</p>" },
    { "type": "text", "id": "customer_name", "label": "Customer name", "default": "Customer name" },
    { "type": "text", "id": "customer_detail", "label": "Customer detail", "default": "Verified customer" },
    { "type": "image_picker", "id": "image", "label": "Editorial image" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "font_picker", "id": "heading_font", "label": "Display font", "default": "assistant_n4" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3F3F3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#5A4033" }
  ],
  "presets": [{ "name": "Editorial testimonial" }],
  "tag": null,
  "class": "editorial-testimonial-block"
}
{% endschema %}