{%- liquid
  assign sid = section.id
-%}

<style>
  .tl-{{ sid }} {
    --tl-accent: {{ section.settings.accent_color }};
    --tl-text: {{ section.settings.text_color }};
    --tl-muted: {{ section.settings.muted_color }};
    --tl-line: {{ section.settings.line_color }};
    --tl-bg: {{ section.settings.bg_color }};
    box-sizing: border-box;
    background: var(--tl-bg);
    color: var(--tl-text);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    margin: 20px 0;
    overflow: hidden;
  }
  .tl-{{ sid }} *, .tl-{{ sid }} *::before, .tl-{{ sid }} *::after { box-sizing: border-box; }

  /* ---------- Heading ---------- */
  .tl-{{ sid }} .tl__head { max-width: 640px; margin: 0 auto 56px; text-align: center; }
  .tl-{{ sid }} .tl__head h2 { margin: 0 0 12px; font-size: clamp(26px, 4vw, 40px); line-height: 1.15; font-weight: 600; }
  .tl-{{ sid }} .tl__head p { margin: 0; color: var(--tl-muted); font-size: 16px; line-height: 1.6; }

  /* ---------- Timeline ---------- */
  .tl-{{ sid }} .tl__list { position: relative; max-width: 960px; margin: 0 auto; padding: 0; list-style: none; }

  /* background line + animated progress line */
  .tl-{{ sid }} .tl__list::before,
  .tl-{{ sid }} .tl__progress {
    content: "";
    position: absolute;
    top: 0; bottom: 0;
    left: 27px;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
  }
  .tl-{{ sid }} .tl__list::before { background: var(--tl-line); }
  .tl-{{ sid }} .tl__progress {
    bottom: auto;
    height: calc(var(--tl-progress, 0) * 100%);
    background: var(--tl-accent);
    z-index: 1;
  }

  .tl-{{ sid }} .tl__item {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    column-gap: 20px;
    align-items: start;
    padding-bottom: 44px;
  }
  .tl-{{ sid }} .tl__item:last-child { padding-bottom: 0; }

  /* icon bubble */
  .tl-{{ sid }} .tl__icon {
    position: relative;
    z-index: 2;
    grid-column: 1;
    width: 56px; height: 56px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: var(--tl-bg);
    border: 2px solid var(--tl-line);
    color: var(--tl-muted);
    transition: border-color .5s ease, color .5s ease, background .5s ease, transform .5s cubic-bezier(.34,1.56,.64,1);
  }
  .tl-{{ sid }} .tl__icon svg {
    width: 24px; height: 24px;
    fill: none; stroke: currentColor; stroke-width: 1.7;
    stroke-linecap: round; stroke-linejoin: round;
  }

  /* content */
  .tl-{{ sid }} .tl__content { grid-column: 2; padding-top: 6px; }
  .tl-{{ sid }} .tl__step { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--tl-accent); }
  .tl-{{ sid }} .tl__title { margin: 0 0 6px; font-size: 20px; font-weight: 600; line-height: 1.3; }
  .tl-{{ sid }} .tl__text { margin: 0; color: var(--tl-muted); font-size: 15px; line-height: 1.6; }

  /* ---------- Animation (only when JS is running) ---------- */
  .tl-{{ sid }}.is-js .tl__icon { transform: scale(.7); }
  .tl-{{ sid }}.is-js .tl__content { opacity: 0; transform: translateY(24px); transition: opacity .7s ease .1s, transform .7s ease .1s; }
  .tl-{{ sid }}.is-js .tl__item.is-visible .tl__content { opacity: 1; transform: none; }
  .tl-{{ sid }}.is-js .tl__item.is-visible .tl__icon {
    transform: scale(1);
    border-color: var(--tl-accent);
    background: var(--tl-accent);
    color: #fff;
  }

  /* ---------- Desktop: alternate left / right around a centre line ---------- */
  @media (min-width: 850px) {
    .tl-{{ sid }} .tl__list::before,
    .tl-{{ sid }} .tl__progress { left: 50%; }
    .tl-{{ sid }} .tl__item { grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr); column-gap: 40px; }
    .tl-{{ sid }} .tl__icon { grid-column: 2; grid-row: 1; }
    .tl-{{ sid }} .tl__item:nth-child(odd) .tl__content { grid-column: 1; grid-row: 1; text-align: right; }
    .tl-{{ sid }} .tl__item:nth-child(even) .tl__content { grid-column: 3; grid-row: 1; text-align: left; }
    .tl-{{ sid }}.is-js .tl__item:nth-child(odd) .tl__content { transform: translateX(-28px); }
    .tl-{{ sid }}.is-js .tl__item:nth-child(even) .tl__content { transform: translateX(28px); }
    .tl-{{ sid }}.is-js .tl__item.is-visible .tl__content { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-{{ sid }} .tl__icon,
    .tl-{{ sid }} .tl__content { transition: none !important; }
  }
</style>

<section id="tl-{{ sid }}" class="tl-{{ sid }}" data-animate="{{ section.settings.animate }}">
  <div class="tl__head">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p>{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <ol class="tl__list">
    <span class="tl__progress" aria-hidden="true"></span>

    {%- for block in section.blocks -%}
      <li class="tl__item" {{ block.shopify_attributes }}>
        <div class="tl__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            {%- case block.settings.icon -%}
              {%- when 'star' -%}
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              {%- when 'heart' -%}
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              {%- when 'clock' -%}
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              {%- when 'gift' -%}
                <polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
              {%- when 'truck' -%}
                <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
              {%- when 'shield' -%}
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              {%- when 'flag' -%}
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
              {%- when 'mail' -%}
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/>
              {%- when 'box' -%}
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
              {%- when 'pin' -%}
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              {%- else -%}
                <polyline points="20 6 9 17 4 12"/>
            {%- endcase -%}
          </svg>
        </div>

        <div class="tl__content">
          {%- if block.settings.step != blank -%}<span class="tl__step">{{ block.settings.step }}</span>{%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="tl__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="tl__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>
</section>

<script>
(function () {
  var root = document.getElementById('tl-{{ sid }}');
  if (!root) return;

  var items = root.querySelectorAll('.tl__item');
  var list = root.querySelector('.tl__list');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var animate = root.dataset.animate === 'true' && !reduce && 'IntersectionObserver' in window;

  /* no animation: show everything and fill the line */
  if (!animate) {
    items.forEach(function (el) { el.classList.add('is-visible'); });
    list.style.setProperty('--tl-progress', 1);
    return;
  }

  root.classList.add('is-js');

  /* items reveal one by one when scrolled into view */
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.35 });
  items.forEach(function (el) { io.observe(el); });

  /* progress line follows the scroll */
  var ticking = false;
  function update() {
    ticking = false;
    var r = list.getBoundingClientRect();
    var p = (window.innerHeight * 0.6 - r.top) / r.height;
    list.style.setProperty('--tl-progress', Math.max(0, Math.min(1, p)).toFixed(4));
  }
  function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
})();
</script>

{% schema %}
{
  "name": "Timeline",
  "tag": "div",
  "class": "section-timeline",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Journey" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "A few simple steps that show how we got here." },

    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "animate", "label": "Animate on scroll", "default": true },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_color", "label": "Muted text and icons", "default": "#6b6b6b" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0c60a5" },
    { "type": "color", "id": "line_color", "label": "Line", "default": "#e3e3e3" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 160, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 160, "step": 4, "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "clock", "label": "Clock" },
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "flag", "label": "Flag" },
            { "value": "mail", "label": "Mail" },
            { "value": "box", "label": "Box" },
            { "value": "pin", "label": "Location pin" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "step", "label": "Label (date or step)", "default": "Step 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title goes here" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A short description of this step in the timeline." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Timeline",
      "blocks": [
        { "type": "step", "settings": { "icon": "flag", "step": "2019", "title": "We started", "text": "Our first collection launched from a small studio." } },
        { "type": "step", "settings": { "icon": "box", "step": "2021", "title": "Went worldwide", "text": "We began shipping to customers in over 40 countries." } },
        { "type": "step", "settings": { "icon": "star", "step": "2023", "title": "Award winning", "text": "Recognised for craftsmanship and customer service." } },
        { "type": "step", "settings": { "icon": "heart", "step": "Today", "title": "Still growing", "text": "Thank you for being part of the story." } }
      ]
    }
  ]
}
{% endschema %}